# Copy this file to .env and fill in your own values.
# Never commit your real .env file. It is already listed in .gitignore.

# --- API keys ---------------------------------------------------------------

# Etherscan API key. One key works for every supported chain.
# Get a free key at https://etherscan.io/myapikey
# Note: the free plan does not cover transaction history on Base and BNB Chain.
# It does cover Arc (chain ID 5042).
# On those chains the server falls back to RPC data and says so in its answers.
ETHERSCAN_API_KEY=

# GoPlus Security keys (optional). GoPlus works without a key, but with lower limits.
# Get them at https://gopluslabs.io (developer dashboard).
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# --- RPC endpoints (optional) -----------------------------------------------
# An RPC endpoint is a server that answers questions about the blockchain.
# Free public endpoints are used by default. Set these to use your own
# (for example a free Alchemy or Infura URL) for better reliability.
RPC_URL_ETHEREUM=
RPC_URL_BASE=
RPC_URL_ARBITRUM=
RPC_URL_POLYGON=
RPC_URL_BSC=
RPC_URL_ARC=

# --- Behaviour ---------------------------------------------------------------
# How long to wait for one API call, in seconds.
HTTP_TIMEOUT_SECONDS=15
# How many times to retry a failed call before giving up.
HTTP_MAX_RETRIES=3
# How long to keep answers in the cache, in seconds.
CACHE_TTL_SECONDS=300

# Log level: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# --- HTTP transport (only used with --transport http) ------------------------
HTTP_HOST=127.0.0.1
HTTP_PORT=8000

# --- Arc Safe Send web app (only used by web3-risk-web) ------------------------
# Where to listen. Hosts like Render set PORT for you.
WEB_HOST=127.0.0.1
PORT=8080
# How long to reuse a finished check, in seconds.
WEB_RESULT_CACHE_SECONDS=600
# Limits that protect your free API keys. Answers from the cache do not count.
WEB_CHECKS_PER_MINUTE=6
WEB_CHECKS_PER_HOUR=40
WEB_CHECKS_PER_DAY=1500
WEB_MAX_PARALLEL_CHECKS=3
# The header that holds the visitor's real IP, set by your host's proxy.
# On Render use: true-client-ip. Leave empty when nothing sits in front of the app.
WEB_CLIENT_IP_HEADER=
# Your RiskAttestation contract on Arc, once deployed (see contracts/README.md).
# Empty hides the "Save this check on Arc" button.
ATTESTATION_CONTRACT=
